{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neil-young-tiers",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Public (non-secret) config. Secrets (DISCORD_CLIENT_SECRET, SESSION_SECRET)
  // are set with `wrangler secret put <NAME>` — never put them here.
  "vars": {
    // Application ID from the Discord Developer Portal
    "DISCORD_CLIENT_ID": "YOUR_DISCORD_CLIENT_ID",
    // Right-click your Discord server icon → "Copy Server ID" (enable Developer Mode first)
    "DISCORD_GUILD_ID": "YOUR_DISCORD_GUILD_ID",
    // Comma-separated Discord user IDs allowed to add/edit/remove albums
    "ADMIN_DISCORD_IDS": "YOUR_ADMIN_DISCORD_ID"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neil-young-tiers",
      // Replace with the id printed by: wrangler d1 create neil-young-tiers
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
