{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neil-young-tiers",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "tiers.guidegather.com", "custom_domain": true }],
  // All Discord configuration lives in Worker secrets (`wrangler secret put`)
  // and, for local dev, in the gitignored .dev.vars — never in this file:
  // DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_GUILD_ID,
  // ADMIN_DISCORD_IDS, SESSION_SECRET.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neil-young-tiers",
      "database_id": "0cc78c01-6514-4a7e-bb87-14d23827e9c4"
    }
  ]
}
